{
  "name": "aniview",
  "version": "1.0.0",
  "description": "AniView - 动漫桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "test": "node --test tests/*.test.js",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:zip": "electron-builder --win --config.win.target=zip",
    "postinstall": "node scripts/prepare-assets.js"
  },
  "build": {
    "appId": "com.aniview.desktop",
    "productName": "AniView",
    "files": ["main.js", "preload.js", "src/**/*", "resources/**/*", "package.json"],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "hls.js": "^1.5.0",
    "https-proxy-agent": "^5.0.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@electron/get": "^1.14.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.0.0"
  }
}
